{%- set P = "font-size: 16px; line-height: 1.8; margin-bottom: 16px;" -%}
{%- set H2 = "font-size: 22px; font-weight: 700; margin-bottom: 16px; margin-top: 8px;" -%}
{%- set H3 = "font-size: 18px; font-weight: 700; margin-bottom: 8px; margin-top: 16px;" -%}
{%- set RULE = '<hr style="border: none; border-top: 1px solid #e0e0e0;">' -%}
<div style="max-width: 720px; margin: 0 auto; font-family: Arial, Helvetica, sans-serif; color: #1a1a1a;">

  <img src="{{ image.url }}"
       alt="{{ image.alt }}"
       title="{{ image.title }}"
       style="width: 100%; height: auto; border-radius: 6px; margin-bottom: 16px;" />

{% if article.include_h1 %}
  <h1 style="font-size: 28px; font-weight: 700; line-height: 1.3; margin-bottom: 8px;">{{ article.headline }}</h1>
{% endif %}
  <p style="font-size: 14px; line-height: 1.6; margin-bottom: 24px; color: #666;">
  By {{ article.author }} &middot; {{ article.date_display }}
  </p>

{% for para in article.intro %}
  <p style="{{ P }}">
  {{ para }}
  </p>
{% endfor %}

{% for section in article.sections %}
  {{ RULE }}

  <h2 style="{{ H2 }}">{{ section.heading }}</h2>
{% for para in section.paragraphs %}
  <p style="{{ P }}">
  {{ para }}
  </p>
{% endfor %}
{% if section.bullets %}
  <ul style="font-size: 16px; line-height: 1.8; margin-bottom: 16px; padding-left: 20px;">
{% for bullet in section.bullets %}
    <li>{{ bullet }}</li>
{% endfor %}
  </ul>
{% endif %}
{% endfor %}

{% if article.cta %}
  {{ RULE }}

  <p style="{{ P }}">
  {{ article.cta_before }}{% if article.cta_url %}<a href="{{ article.cta_url }}" target="_blank" rel="noopener">{{ article.cta_link_text }}</a>{% endif %}{{ article.cta_after }}
  </p>
{% endif %}

  {{ RULE }}

  <h2 style="{{ H2 }}">Frequently Asked Questions</h2>
{% for item in faq %}

  <h3 style="{{ H3 }}">{{ item.question }}</h3>
  <p style="{{ P }}">
  {{ item.answer }}
  </p>
{% endfor %}

  {{ RULE }}

  <h2 style="{{ H2 }}">References</h2>
  <ol style="font-size: 16px; line-height: 1.8; margin-bottom: 16px;">
{% for ref in references %}
    <li><a href="{{ ref.url }}" target="_blank" rel="noopener">{{ ref.publisher }}{% if ref.publisher and ref.title %} - {% endif %}{{ ref.title }}</a></li>
{% endfor %}
  </ol>

</div>
