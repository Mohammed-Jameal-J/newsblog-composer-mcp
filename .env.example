# ---------------------------------------------------------------------------
# Every key below is OPTIONAL. With none set, the server still runs:
#   verify_news        -> GDELT (official, free, no key) then news RSS
#   fetch_article_facts-> direct HTTP + trafilatura (never needs a key)
#   build_schema       -> pure templating
#   humanize_text      -> returns rewrite instructions for the calling LLM
#   score_ai_text      -> local heuristic scorer (clearly labelled as such)
#   generate_image     -> keyless Pollinations endpoint (watermark, slow)
#   seo_keywords       -> source-mined keywords + keyless Google autocomplete
#   seo_audit          -> pure on-page analysis
# Setting a key upgrades that one tool to a real API. Nothing else changes.
# ---------------------------------------------------------------------------

# --- Search (verify_news) ---
# Keyed providers run first, then the keyless ones (GDELT, then Bing/Google RSS).
# TAVILY is the best free option in 2026: 1,000 credits/month, no card.
TAVILY_API_KEY=
# BRAVE now requires a card and bills past a $5 monthly credit (~1,000 requests).
BRAVE_API_KEY=
# SERPER gives 2,500 one-time credits, no card, no monthly renewal.
SERPER_API_KEY=
# GOOGLE CSE: 100 queries/day free, no card. Needs both values.
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=
# NEWSAPI free tier is non-commercial only and delays recent articles.
NEWSAPI_KEY=
# Force one provider: tavily|brave|serper|google_cse|newsapi|gdelt|bing_rss|google_rss
SEARCH_PROVIDER=
# How far back GDELT looks (e.g. 3d, 14d, 1m)
GDELT_TIMESPAN=14d

# --- Server-side rewrite (humanize_text) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- AI detection (score_ai_text) ---
GPTZERO_API_KEY=
SAPLING_API_KEY=

# --- Image generation (generate_image) ---
# openai|stability|cloudflare|pollinations
# pollinations works with no key at all, but the anonymous tier is limited to
# roughly one request every 15s and may watermark the output. A free token from
# auth.pollinations.ai removes the watermark. cloudflare (FLUX schnell) has a
# free daily allowance and no watermark - the better free option for publishing.
IMAGE_PROVIDER=pollinations
POLLINATIONS_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
STABILITY_API_KEY=

# --- House identity, used in JSON-LD and the byline ---
# Leave these blank. The server asks for them on first use and stores the
# answers in profile.json, which overrides anything set here. They exist only
# as a fallback for scripted runs that never touch the setup questions.
SITE_LANGUAGE=en
SITE_NAME=
SITE_BASE_URL=
AUTHOR_NAME=
PUBLISHER_NAME=
PUBLISHER_URL=
PUBLISHER_LOGO_URL=
# IANA name. Drives the offset in datePublished, e.g. Asia/Kolkata, America/Chicago.
SITE_TIMEZONE=UTC
# Blogger-style permalink. Use {base}/{slug} for most other CMSes.
PERMALINK_PATTERN={base}/{yyyy}/{mm}/{slug}.html
# Blogger renders the post title as the page H1, so the body must not repeat it.
BODY_INCLUDES_H1=false

# --- Closing call to action ---
CTA_URL=
CTA_LINK_TEXT=

# --- Output ---
OUTPUT_DIR=./output
HTTP_USER_AGENT=Mozilla/5.0 (compatible; NewsBlogMCP/0.1)
