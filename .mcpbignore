output/
dist/
build/
.venv/
venv/
tests/
examples/
__pycache__/
*.pyc
*.egg-info/
.env
profile.json
.git/
.gitignore
.mcpbignore
server.json
mcp-publisher.exe
*.tar.gz
*.mcpb

# Saved posts. These carry the author's real name, company and blog domain, and
# .gitignore covering them does NOT keep them out of the package - the two lists
# are read by different tools. Removing this line ships that identity to every
# person who installs the extension. It has happened once already.
Claude outputs/
output/

# Stray file created by a bad shell redirect. Harmless, but it has no business
# in a published archive.
$null

# Artwork source and README imagery. The bundle needs the six icons and nothing
# else; shipping the full-resolution mascot made it 6.6 MB.
assets/logo-source.png
assets/logo-600.png
assets/make_icon.py

# The live post index. Runtime data, not source: it carries the slugs and
# URLs of posts the installing user has written. It belongs in the data
# directory, never in the package or the repo.
post_index.json

# pytest scratch. Created by running the suite in the repo; it is not source
# and has no business in the package.
.pytest_cache/
